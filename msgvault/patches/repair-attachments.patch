@@ -0,0 +1,481 @@
+package cmd
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"time"
+
+	"github.com/spf13/cobra"
+	"go.kenn.io/msgvault/internal/attachmentstore"
+	"go.kenn.io/msgvault/internal/export"
+	"go.kenn.io/msgvault/internal/mime"
+	"go.kenn.io/msgvault/internal/store"
+	msgsync "go.kenn.io/msgvault/internal/sync"
+)
+
+const (
+	attachmentRepairDateLayout  = "2006-01-02"
+	attachmentRepairSampleLimit = 10
+)
+
+var (
+	repairAttachmentsSince string
+	repairAttachmentsUntil string
+	repairAttachmentsApply bool
+)
+
+var repairAttachmentsCmd = &cobra.Command{
+	Use:   "repair-attachments",
+	Short: "Restore attachments of archived messages from their raw MIME",
+	Long: `Re-parse the stored raw MIME of every message archived between --since
+and --until (UTC dates, both inclusive, matched against the time msgvault
+archived the message, not its sent date) and restore each attachment whose
+row is missing or whose stored file can no longer be read.
+
+The default is a read-only report that neither upgrades nor migrates the
+archive. Pass --apply to write the attachment files and rows and refresh the
+analytics cache. The command runs against the local SQLite archive only and
+fails while a daemon owns it.`,
+	Args: cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, args []string) error {
+		since, err := time.Parse(attachmentRepairDateLayout, repairAttachmentsSince)
+		if err != nil {
+			return usageErr(cmd, fmt.Errorf("--since: %w", err))
+		}
+		until, err := time.Parse(attachmentRepairDateLayout, repairAttachmentsUntil)
+		if err != nil {
+			return usageErr(cmd, fmt.Errorf("--until: %w", err))
+		}
+		if until.Before(since) {
+			return usageErr(cmd, fmt.Errorf("--until %s is before --since %s",
+				repairAttachmentsUntil, repairAttachmentsSince))
+		}
+		return runRepairAttachmentsLocal(cmd, since, until, repairAttachmentsApply)
+	},
+}
+
+type plannedAttachmentRepair struct {
+	messageID  int64
+	attachment mime.Attachment
+	// rowExists marks a surviving row whose file cannot be read.
+	rowExists bool
+	// unkeyedRow marks a match on a row stored without a source part key;
+	// writing the key can insert a second row beside it.
+	unkeyedRow bool
+}
+
+type attachmentRepairPlan struct {
+	messages        int
+	rawMIMEFailures int
+	repairs         []plannedAttachmentRepair
+}
+
+// runRepairAttachmentsLocal never forwards to a daemon: the daemon runs only
+// allowlisted commands, and the write-owner lock taken here makes the repair
+// fail rather than race a running daemon.
+func runRepairAttachmentsLocal(
+	cmd *cobra.Command,
+	since, until time.Time,
+	apply bool,
+) (runErr error) {
+	ctx := cmd.Context()
+	state := invocationFromCommand(cmd)
+	if state == nil || state.cfg == nil {
+		return errors.New("configuration is unavailable")
+	}
+	cfg := state.cfg
+	if store.IsPostgresURL(cfg.DatabaseDSN()) {
+		return errors.New("repair-attachments supports SQLite archives only")
+	}
+	st, cleanup, err := openAttachmentRepairStore(state, apply)
+	if err != nil {
+		return err
+	}
+	defer cleanup()
+
+	blobs, err := attachmentstore.New(store.NewPackCatalog(st), cfg.AttachmentsDir())
+	if err != nil {
+		return err
+	}
+	defer func() { runErr = errors.Join(runErr, blobs.Close()) }()
+
+	plan, err := planAttachmentRepairs(ctx, st, blobs, since, until.AddDate(0, 0, 1))
+	if err != nil {
+		return err
+	}
+	out := cmd.OutOrStdout()
+	printAttachmentRepairPlan(out, plan, since, until)
+
+	var failures []error
+	if plan.rawMIMEFailures > 0 {
+		failures = append(failures, fmt.Errorf(
+			"%d message(s) whose raw MIME could not be read or parsed",
+			plan.rawMIMEFailures))
+	}
+	if !apply {
+		_, err := fmt.Fprintln(out,
+			"\nDry run: nothing was written. Re-run with --apply to restore.")
+		return errors.Join(append(failures, err)...)
+	}
+	restored := 0
+	if len(plan.repairs) == 0 {
+		if _, err := fmt.Fprintln(out, "Nothing to repair."); err != nil {
+			failures = append(failures, err)
+		}
+	}
+	for _, repair := range plan.repairs {
+		if err := ctx.Err(); err != nil {
+			failures = append(failures, err)
+			break
+		}
+		att := repair.attachment
+		write, err := storeRepairedAttachment(cfg.AttachmentsDir(), &att)
+		if err == nil && write.StoragePath == "" {
+			err = errors.New("attachment file was not stored")
+		}
+		if err == nil {
+			if repair.unkeyedRow {
+				write.SourcePartKey = ""
+			}
+			err = st.UpsertAttachmentRecordWithStats(ctx, repair.messageID, write, true)
+		}
+		if err == nil && !attachmentBlobReadable(ctx, blobs, write.ContentHash) {
+			err = dropDeadPackEntry(ctx, st, blobs, write.ContentHash)
+		}
+		if err != nil {
+			failures = append(failures, fmt.Errorf("message %d part %q: %w",
+				repair.messageID, repair.attachment.PartKey, err))
+			continue
+		}
+		restored++
+	}
+	if len(plan.repairs) > 0 {
+		if _, err := fmt.Fprintf(out, "Restored %d attachment(s).\n", restored); err != nil {
+			failures = append(failures, err)
+		}
+	}
+	// Rows can commit even when their blob then fails to verify, and an earlier
+	// run's refresh may have failed; the rebuild is a no-op when the cache is
+	// current.
+	if err := rebuildCacheAfterWrite(cfg.DatabaseDSN(), state); err != nil {
+		failures = append(failures, err)
+	}
+	if len(failures) > 0 {
+		return fmt.Errorf("repair-attachments: %d error(s): %w",
+			len(failures), errors.Join(failures...))
+	}
+	return nil
+}
+
+// openAttachmentRepairStore takes the write-owner lock in both modes, so a dry
+// run also refuses while a daemon owns the archive, but only --apply may
+// initialize or migrate the schema.
+func openAttachmentRepairStore(state *invocation, apply bool) (*store.Store, func(), error) {
+	if apply {
+		return openWritableStoreAndInitForInvocation(state)
+	}
+	release, err := acquireDirectSQLiteWriteLock(state.cfg, state)
+	if err != nil {
+		return nil, nil, err
+	}
+	st, err := store.OpenReadOnly(state.cfg.DatabaseDSN())
+	if err != nil {
+		release()
+		return nil, nil, fmt.Errorf("open archive: %w", err)
+	}
+	if err := checkAttachmentRepairSchema(st); err != nil {
+		_ = st.Close()
+		release()
+		return nil, nil, err
+	}
+	return st, func() {
+		_ = st.Close()
+		release()
+	}, nil
+}
+
+// checkAttachmentRepairSchema confirms a dry run can read everything the
+// repair reads without the schema upgrade that only --apply performs.
+func checkAttachmentRepairSchema(st *store.Store) error {
+	upgradeErr := func(cause error) error {
+		return fmt.Errorf("the archive schema needs an upgrade before a dry run "+
+			"can read it (%w); run with --apply, which upgrades it, or upgrade "+
+			"the archive with another msgvault write command first", cause)
+	}
+	stale, column, err := st.SchemaStale()
+	if err != nil {
+		return err
+	}
+	if stale {
+		return upgradeErr(fmt.Errorf("missing %s", column))
+	}
+	rows, err := st.DB().Query(`
+		SELECT m.archived_at, r.raw_format, r.raw_data, r.compression,
+		       a.source_part_key, a.content_hash, a.thumbnail_hash, p.blob_hash
+		FROM messages m, message_raw r, attachments a, attachment_pack_index p
+		LIMIT 0`)
+	if err != nil {
+		return upgradeErr(err)
+	}
+	return rows.Close()
+}
+
+// dropDeadPackEntry lets the restored loose copy serve a blob whose pack can no
+// longer be read: the catalog serves a pack index entry in preference to a
+// loose file, and the loose copy was written against the expected hash.
+func dropDeadPackEntry(
+	ctx context.Context,
+	st *store.Store,
+	blobs *attachmentstore.Store,
+	hash string,
+) error {
+	unreadable := fmt.Errorf("attachment %s still cannot be read after the restore", hash)
+	if err := ctx.Err(); err != nil {
+		return errors.Join(unreadable, err)
+	}
+	entry, err := st.GetAttachmentPackEntry(hash)
+	if err != nil {
+		return errors.Join(unreadable, err)
+	}
+	if entry == nil {
+		return unreadable
+	}
+	if err := st.DeletePackIndexEntryContext(ctx, hash); err != nil {
+		return errors.Join(unreadable, err)
+	}
+	if !attachmentBlobReadable(ctx, blobs, hash) {
+		return unreadable
+	}
+	return nil
+}
+
+// storeRepairedAttachment also publishes an empty part, which sync skips but
+// relocation stores.
+func storeRepairedAttachment(attachmentsDir string, att *mime.Attachment) (store.AttachmentWrite, error) {
+	if len(att.Content) > 0 {
+		return msgsync.StoreMIMEAttachment(attachmentsDir, att)
+	}
+	storagePath, err := export.StoreAttachmentFileIncludingEmpty(attachmentsDir, att)
+	if err != nil || storagePath == "" {
+		return store.AttachmentWrite{}, err
+	}
+	role, roleSource := store.AttachmentRoleFromMIME(
+		att.Disposition, att.IsInline, att.ContentID)
+	return store.AttachmentWrite{
+		Filename:      att.Filename,
+		MIMEType:      att.ContentType,
+		StoragePath:   storagePath,
+		ContentHash:   att.ContentHash,
+		Role:          role,
+		RoleSource:    roleSource,
+		SourcePartKey: att.PartKey,
+		ContentID:     att.ContentID,
+	}, nil
+}
+
+type attachmentRepairRow struct {
+	sourcePartKey string
+	contentHash   string
+}
+
+func planAttachmentRepairs(
+	ctx context.Context,
+	st *store.Store,
+	blobs *attachmentstore.Store,
+	from, to time.Time,
+) (*attachmentRepairPlan, error) {
+	messageIDs, err := listMIMEMessagesArchivedBetween(ctx, st, from, to)
+	if err != nil {
+		return nil, err
+	}
+	plan := &attachmentRepairPlan{messages: len(messageIDs)}
+	for _, messageID := range messageIDs {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		raw, err := st.GetMessageRawContext(ctx, messageID)
+		if err != nil {
+			plan.rawMIMEFailures++
+			continue
+		}
+		parsed, err := mime.Parse(raw)
+		if err != nil {
+			plan.rawMIMEFailures++
+			continue
+		}
+		if len(parsed.Attachments) == 0 {
+			continue
+		}
+		rows, err := listAttachmentRepairRows(ctx, st, messageID)
+		if err != nil {
+			return nil, err
+		}
+		for _, att := range parsed.Attachments {
+			row, unkeyed, found := matchAttachmentRepairRow(rows, att)
+			if found && attachmentBlobReadable(ctx, blobs, row.contentHash) {
+				continue
+			}
+			// Sync never stores an empty part, so only a surviving row marks
+			// one as lost.
+			if !found && len(att.Content) == 0 {
+				continue
+			}
+			plan.repairs = append(plan.repairs, plannedAttachmentRepair{
+				messageID:  messageID,
+				attachment: att,
+				rowExists:  found,
+				unkeyedRow: unkeyed,
+			})
+		}
+	}
+	return plan, nil
+}
+
+func listMIMEMessagesArchivedBetween(
+	ctx context.Context,
+	st *store.Store,
+	from, to time.Time,
+) ([]int64, error) {
+	rows, err := st.DB().QueryContext(ctx, st.Rebind(`
+		SELECT m.id
+		FROM messages m
+		JOIN message_raw mr ON mr.message_id = m.id AND mr.raw_format = 'mime'
+		WHERE m.archived_at >= ? AND m.archived_at < ?
+		ORDER BY m.id
+	`), archiveTimeArg(from), archiveTimeArg(to))
+	if err != nil {
+		return nil, fmt.Errorf("list messages archived in window: %w", err)
+	}
+	defer func() { _ = rows.Close() }()
+	var ids []int64
+	for rows.Next() {
+		var id int64
+		if err := rows.Scan(&id); err != nil {
+			return nil, fmt.Errorf("scan archived message id: %w", err)
+		}
+		ids = append(ids, id)
+	}
+	return ids, rows.Err()
+}
+
+// archiveTimeArg matches SQLite's CURRENT_TIMESTAMP text layout, which is how
+// archived_at is stored there; a driver-formatted time would compare as text
+// against a different layout.
+func archiveTimeArg(t time.Time) string {
+	return t.UTC().Format("2006-01-02 15:04:05")
+}
+
+func listAttachmentRepairRows(
+	ctx context.Context,
+	st *store.Store,
+	messageID int64,
+) ([]attachmentRepairRow, error) {
+	rows, err := st.DB().QueryContext(ctx, st.Rebind(`
+		SELECT COALESCE(source_part_key, ''), COALESCE(content_hash, '')
+		FROM attachments WHERE message_id = ?
+	`), messageID)
+	if err != nil {
+		return nil, fmt.Errorf("list attachments of message %d: %w", messageID, err)
+	}
+	defer func() { _ = rows.Close() }()
+	var result []attachmentRepairRow
+	for rows.Next() {
+		var row attachmentRepairRow
+		if err := rows.Scan(&row.sourcePartKey, &row.contentHash); err != nil {
+			return nil, fmt.Errorf("scan attachment of message %d: %w", messageID, err)
+		}
+		result = append(result, row)
+	}
+	return result, rows.Err()
+}
+
+// matchAttachmentRepairRow finds the row sync would have written for att: by
+// source_part_key, or by content hash for rows written without one.
+func matchAttachmentRepairRow(
+	rows []attachmentRepairRow,
+	att mime.Attachment,
+) (row attachmentRepairRow, unkeyed, found bool) {
+	if att.PartKey != "" {
+		for _, r := range rows {
+			if r.sourcePartKey == att.PartKey {
+				return r, false, true
+			}
+		}
+	}
+	for _, r := range rows {
+		if r.sourcePartKey == "" && r.contentHash == att.ContentHash {
+			return r, true, true
+		}
+	}
+	return attachmentRepairRow{}, false, false
+}
+
+// attachmentBlobReadable reads the whole blob through the attachment store, so
+// a packed blob counts as present and a truncated or corrupt one does not.
+func attachmentBlobReadable(
+	ctx context.Context,
+	blobs *attachmentstore.Store,
+	hash string,
+) bool {
+	if hash == "" {
+		return false
+	}
+	reader, _, err := blobs.OpenStream(ctx, hash)
+	if err != nil {
+		return false
+	}
+	_, copyErr := io.Copy(io.Discard, reader)
+	return errors.Join(copyErr, reader.Close()) == nil
+}
+
+func printAttachmentRepairPlan(
+	out io.Writer,
+	plan *attachmentRepairPlan,
+	since, until time.Time,
+) {
+	missingRows := 0
+	for _, repair := range plan.repairs {
+		if !repair.rowExists {
+			missingRows++
+		}
+	}
+	_, _ = fmt.Fprintf(out,
+		"Scanned %d message(s) with raw MIME archived %s through %s (UTC).\n",
+		plan.messages,
+		since.Format(attachmentRepairDateLayout),
+		until.Format(attachmentRepairDateLayout))
+	if plan.rawMIMEFailures > 0 {
+		_, _ = fmt.Fprintf(out, "Messages whose raw MIME could not be read or parsed: %d\n",
+			plan.rawMIMEFailures)
+	}
+	_, _ = fmt.Fprintf(out,
+		"Attachments to restore: %d (%d without a row, %d with an unreadable file)\n",
+		len(plan.repairs), missingRows, len(plan.repairs)-missingRows)
+	for i, repair := range plan.repairs {
+		if i >= attachmentRepairSampleLimit {
+			_, _ = fmt.Fprintf(out, "  ... and %d more\n",
+				len(plan.repairs)-attachmentRepairSampleLimit)
+			break
+		}
+		reason := "no row"
+		if repair.rowExists {
+			reason = "file unreadable"
+		}
+		_, _ = fmt.Fprintf(out, "  message %d: %q (%s)\n",
+			repair.messageID, repair.attachment.Filename, reason)
+	}
+}
+
+func init() {
+	repairAttachmentsCmd.Flags().StringVar(&repairAttachmentsSince, "since", "",
+		"first archive date to scan (YYYY-MM-DD, UTC)")
+	repairAttachmentsCmd.Flags().StringVar(&repairAttachmentsUntil, "until", "",
+		"last archive date to scan (YYYY-MM-DD, UTC, inclusive)")
+	repairAttachmentsCmd.Flags().BoolVar(&repairAttachmentsApply, "apply", false,
+		"write restored attachments to the archive")
+	_ = repairAttachmentsCmd.MarkFlagRequired("since")
+	_ = repairAttachmentsCmd.MarkFlagRequired("until")
+	rootCmd.AddCommand(repairAttachmentsCmd)
+}
