+func TestRepairAttachmentsReportsBlobStillUnreadableAfterRestore(t *testing.T) {
+	assert := assert.New(t)
+	require := require.New(t)
+	f := newAttachmentRepairFixture(t)
+	messageID := f.seedMessage(t, "dead-pack",
+		time.Date(2026, 8, 25, 9, 0, 0, 0, time.UTC))
+	hash := filepath.Base(f.storeAttachmentRow(t, messageID))
+	require.NoError(os.Remove(f.packBlob(t, hash)))
+	require.Empty(f.state(t, messageID).contents, "a missing pack leaves the blob unreadable")
+
+	out, err := f.runResult(true)
+	require.Error(err, "a blob that still cannot be read is a failure")
+	assert.Contains(err.Error(), hash)
+	assert.Contains(out, "Restored 0 attachment(s).")
+	assert.Empty(f.state(t, messageID).contents)
+}
