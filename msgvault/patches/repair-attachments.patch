+func TestRepairAttachmentsMatchesLegacyUnkeyedRowByContentHash(t *testing.T) {
+	assert := assert.New(t)
+	require := require.New(t)
+	f := newAttachmentRepairFixture(t)
+	messageID := f.seedMessage(t, "legacy-row",
+		time.Date(2026, 8, 30, 9, 0, 0, 0, time.UTC))
+	blobPath := f.storeAttachmentRowAs(t, messageID, true)
+
+	dryRun := f.run(t, false)
+	assert.Contains(dryRun, "Attachments to restore: 0")
+	assert.Contains(f.run(t, true), "Nothing to repair")
+	assert.Equal(1, f.state(t, messageID).rows, "an intact legacy row gains no keyed twin")
+
+	require.NoError(os.Remove(blobPath))
+	require.Empty(f.state(t, messageID).contents)
+	f.run(t, true)
+	got := f.state(t, messageID)
+	assert.Equal(1, got.rows, "the legacy row is reused, not duplicated")
+	assert.Equal([]string{attachmentRepairContent}, got.contents)
+
+	assert.Contains(f.run(t, true), "Nothing to repair")
+	assert.Equal(1, f.state(t, messageID).rows)
+}
